# Copie para .env e ajuste. Todas tem padrao no docker-compose.yml, entao o
# .env e opcional para rodar localmente - mas TROQUE os segredos em producao.

# Segredo de assinatura do JWT. Gere um valor forte, ex.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=troque-este-segredo
JWT_EXPIRACAO_MIN=30
# Credenciais aceitas no POST /login do gateway
AUTH_USUARIO=admin
AUTH_SENHA=troque-esta-senha

# Rate limit (por minuto): rotas protegidas por usuario; /login por IP
LIMITE_REQ_POR_MIN=30
LIMITE_LOGIN_POR_MIN=10

# Resiliencia das chamadas HTTP do gateway aos servicos internos
SERVICO_TIMEOUT_S=10
SERVICO_MAX_TENTATIVAS=3
SERVICO_BACKOFF_INICIAL_S=0.2
SERVICO_BACKOFF_MAX_S=2
DISJUNTOR_LIMITE_FALHAS=5
DISJUNTOR_DESCANSO_S=30

# Porta do gateway na sua maquina
GATEWAY_PORTA=8000
# Quantos workers consomem a fila
WORKER_REPLICAS=2
# Por quanto tempo (s) o resultado de uma inferencia fica guardado (LGPD)
RESULTADO_TTL_S=3600

OTEL_SERVICE_NAME=plataforma-ia
